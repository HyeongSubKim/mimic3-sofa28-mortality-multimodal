+#!/usr/bin/env bash
+# UTDE (TS_Text, bioLongformer) on the SOFA / lactate / base-excess cohort, 28-day mortality, first W hours.
+# Usage: GPU=1 W=24 [EPOCHS=6] [PY=/path/to/python] [HF_HOME=...] [EXTRA="--debug"] bash run_sofa28.sh
+set -euo pipefail
+export CUDA_VISIBLE_DEVICES=${GPU:-0}
+export HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
+export TOKENIZERS_PARALLELISM=false
+export PYTHONNOUSERSITE=1                       # the env must not see ~/.local packages
+export CLINICAL_LONGFORMER_PATH=$(ls -d $HF_HOME/hub/models--yikuan8--Clinical-Longformer/snapshots/*/ | head -1)
+W=${W:-24}; EPOCHS=${EPOCHS:-6}; SEED=${SEED:-42}; MIXUP=${MIXUP:-batch_seq_feature}
+PY=${PY:-python}                                 # interpreter of the UTDE env (python 3.8, torch 1.13, transformers 4.16)
+$PY -W ignore main.py --num_train_epochs $EPOCHS --modeltype 'TS_Text' \
+    --kernel_size 1 --train_batch_size 2 --eval_batch_size 8 --seed $SEED \
+    --gradient_accumulation_steps 16 --num_update_bert_epochs 2 --bertcount 3 \
+    --ts_learning_rate 0.0004 --txt_learning_rate 0.00002 \
+    --notes_order 'Last' --num_of_notes 5 --max_length 1024 --layers 3 \
+    --output_dir "run/sofa28_W${W}${TAG:-}/" --embed_dim 128 \
+    --model_name "bioLongformer" --task 'ihm' --file_path "Data/sofa28/W${W}" \
+    --num_labels 2 --num_heads 8 --embed_time 64 --tt_max $W --orig_d_ts 21 --select_metric auc \
+    --irregular_learn_emb_text --irregular_learn_emb_ts --reg_ts --TS_mixup --mixup_level $MIXUP --fp16 ${TERMS:+--term_global_attention $TERMS} ${EXTRA:-}
